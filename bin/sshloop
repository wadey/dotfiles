#!/bin/sh

if [ $# -eq 0 ]; then
    echo "Usage: sshloop server ... [-- ssharg ...]" 2>&1
    exit 2
fi

SERVERS=""

for i; do
    shift
    if [ "$i" = "--" ]; then
        break
    fi
    SERVERS="$SERVERS $i"
done

for SERVER in $SERVERS; do
    if echo "$SERVER" | grep -q '^10'
    then
        IP="$SERVER"
    else
        IP="$(dig +short "$SERVER" | grep '^10' | head -n 1)"
    fi
    echo
    echo "$SERVER - $IP"
    echo
    ssh "$IP" "$@"
done
